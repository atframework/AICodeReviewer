{
  "name": "aicodereviewer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" -r run build",
    "clean": "pnpm --filter \"./packages/*\" -r exec rimraf dist coverage .turbo",
    "dev:cli": "pnpm --filter @aicr/cli dev",
    "docs:dev": "pnpm --filter @aicr/docs-site dev",
    "docs:build": "pnpm --filter @aicr/docs-site build",
    "docs:preview": "pnpm --filter @aicr/docs-site preview",
    "docs:check": "pnpm --filter @aicr/docs-site check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "markdownlint": "markdownlint-cli2",
    "eval:validate": "node packages/cli/dist/index.js eval --validate-only",
    "test": "vitest run --coverage",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm markdownlint && pnpm build && pnpm eval:validate"
  },
  "devDependencies": {
    "@aicr/cli": "workspace:*",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}